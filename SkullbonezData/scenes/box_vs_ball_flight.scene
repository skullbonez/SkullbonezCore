# box_vs_ball_flight.scene
# Tests angular velocity response when a box hits a ball off-center mid-air.
#
# Box and ball at different heights converge for an off-center collision in flight.
# The vertical offset ensures tangential contact velocity → angular impulse.
#
# Run: Debug build with --scene SkullbonezData/scenes/box_vs_ball_flight.scene

physics on
text off
frames 300
fixed_step
exit_on_complete
physics_mode solver
world -9.81 0.0 998.0
flat_slope 30.0 0.0 0.0

camera overview 500 120 480  500 100 500  0 1 0

physics_log Debug/box_vs_ball_flight.csv

# Box at y=107 with initial velocity toward ball (offset above ball center)
# box <name> <x y z> <halfX halfY halfZ> <mass> <restitution> [eulerX eulerY eulerZ] [velX velY velZ]
box box_striker 480 107 500  3.0 3.0 3.0  25.0 0.5  0 0 0  20 0 0

# Ball at y=100 launched toward box
# ball <name> <x y z> <radius> <mass> <moment> <restitution> [fx fy fz fpx fpy fpz]
ball ball_target 520 100 500  4.0 20.0 15.0 0.5  -400 0 0  0 0 0
