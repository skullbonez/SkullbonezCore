# box_flush_test.scene
# Verifies that rigid boxes land flush on their faces against terrain.
#
# Test cases:
#   1. box_flat_drop  — Box dropped vertically onto flat terrain (should land on bottom face flush)
#   2. box_tilt_drop  — Box dropped at 20° tilt (should settle flush after rocking)
#   3. box_45_drop    — Box dropped at 45° (should settle to one face)
#   4. box_slope_drop — Box dropped onto a sloped surface (should land flush on slope)
#   5. box_large      — Large box to verify scaling works
#
# All positions are above water (fluid height set to 0.0 via world override).
# flat_slope gives a perfectly analytic surface for deterministic collision.

physics on
text off
frames 1200
fixed_step
screenshot TestOutput/box_flush_test.bmp frame 1200

# Suppress water so tests are clearly visible
world -9.81 0.0 998.0
water_hidden on
flat_slope 30.0 0.0 0.0

# Camera looking at the test area
camera overview 500 80 500  500 35 500  0 1 0

physics_log Debug/box_flush_test.csv

# Box 1: straight drop onto flat surface — should land perfectly flush on bottom face
# box <name> <posX> <posY> <posZ> <halfX> <halfY> <halfZ> <mass> <restitution> [eulerX eulerY eulerZ]
box box_flat_drop 500 60 500  2.0 2.0 2.0  20.0 0.3

# Box 2: tilted 20 degrees around Z — should rock and settle flush
box box_tilt_drop 520 60 500  2.0 2.0 2.0  20.0 0.3  0 0 20

# Box 3: tilted 45 degrees around Z — extreme case
box box_45_drop 540 60 500  2.0 2.0 2.0  20.0 0.2  0 0 45

# Box 4: tilted around both X and Z — 3D tumble
box box_slope_drop 500 60 520  2.0 3.0 2.0  25.0 0.3  15 0 15

# Box 5: large box (different half-extents to test non-uniform scaling)
box box_large 520 70 520  4.0 1.5 3.0  40.0 0.2
