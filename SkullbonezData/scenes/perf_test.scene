# Performance test scene (simulation-focused)
# 300 balls, text overlay disabled, 5 seconds per pass, 2 passes
seed 42
physics on
text off
legacy_balls 300
vsync off
pipeline_sync off
roll_align off
camera cam1 321 110 557  581 40 633  0 1 0
camera cam2 730 100 380  709 92 482  0 1 0
camera cam3 900 110 900  313 31 282  0 1 0
perf_log Profile/perf_log.csv
perf_log_flush off
perf_log_flush_interval 0
