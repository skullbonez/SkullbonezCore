# physics_bench_solver_boxes.scene
# Physics benchmark — impulse solver, 300 boxes (no balls).
#
# Isolates the maximum OBB overhead — box-box collision detection and
# contact generation is the most expensive path in the impulse solver.
#
# Output: Profile/solver_boxes_bench_perf_log.csv

seed 42
physics_mode solver
physics on
text off
vsync off
pipeline_sync off
roll_align off

camera cam1 321 110 557  581 40 633  0 1 0
camera cam2 730 100 380  709 92 482  0 1 0
camera cam3 900 110 900  313 31 282  0 1 0

solver_boxes 300

perf_log Profile/solver_boxes_bench_perf_log.csv
perf_log_flush off
