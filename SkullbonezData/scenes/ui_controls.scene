# UI controls capture: full-size editable scene-control surface.
seed 4242
physics on
text on
text_only off
vsync off
pipeline_sync off
roll_align on
fixed_step
exit_on_complete
time_scale 1.75
debug_vectors on
physics_debug_axes on
physics_debug_contacts on
physics_debug_sleep off
physics_debug_transparent on
physics_debug_alpha 0.42
physics_debug_contact_linger 1.25
collision_visualizer on
broadphase_overlay on
water_freeze off
water_flat on
water_reflection none
water_hidden off
terrain_hidden on
physics_mode solver
solver_balls 180
solver_boxes 60
frames 24
track_height 280
auto_cycle_interval 10
world -12 24 1.2
ui visible on
ui tab controls
ui rect 24 10 820 748
ui blur on
ui renderer_combo closed
ui profiler_expand none
ui_test_pattern on
screenshot Profile/ui_controls.bmp frame 20

camera main 500 60 650  600 33 600  0 1 0
