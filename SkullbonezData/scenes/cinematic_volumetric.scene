# cinematic_volumetric.scene
# Deterministic look-development target for the cinematic HDR, bloom, fog,
# god-ray, cloud, and volumetric rendering plan.

physics off
text on
vsync off
frames 2
exit_on_complete
screenshot Profile/cinematic_volumetric.bmp frame 2
cinematic_rendering on
cinematic_sky_atmosphere on
cinematic_clouds on
cinematic_god_rays on
cinematic_volumetric_lighting on
cinematic_bloom on
cinematic_fog on
cinematic_terrain_relief_enabled on
cinematic_exposure 0.68
cinematic_gamma 2.05
cinematic_sun_screen_x 0.28
cinematic_sun_screen_y 0.76
cinematic_sun_color_r 1.0
cinematic_sun_color_g 0.68
cinematic_sun_color_b 0.32
cinematic_sun_intensity 22.0
cinematic_sky_horizon_r 0.88
