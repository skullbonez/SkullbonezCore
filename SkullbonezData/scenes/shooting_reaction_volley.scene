# shooting_reaction_volley.scene
# Deterministic regression for camera-style projectiles transferring motion.
# Ten small high-speed bullet bodies are fired into ten dynamic targets.
# The validation checker asserts that every target reacts.

seed 4242
physics on
text off
vsync off
frames 32
fixed_step
exit_on_complete
world 0.0 -1000.0 0.0
flat_slope 0.0 0.0 0.0
water_hidden on
terrain_hidden on

camera overview 440 150 500  540 110 500  0 1 0

# Ball targets are loaded before ball_state projectiles by the scene loader.
ball target_ball_00 520 100 434  3.0 1.0 1.0 0.35
ball target_ball_01 520 100 448  3.0 1.0 1.0 0.35
ball target_ball_02 520 100 462  3.0 1.0 1.0 0.35
ball target_ball_03 520 100 476  3.0 1.0 1.0 0.35
ball target_ball_04 520 100 490  3.0 1.0 1.0 0.35

# Bullet analogs match the runtime pool: small, light, and extremely fast.
# Ball impulse is force/mass; 3000 / 0.25 gives the runtime 12000 speed.
ball shot_00 450 100 434  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_01 450 100 448  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_02 450 100 462  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_03 450 100 476  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_04 450 100 490  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_05 450 100 506  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_06 450 100 520  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_07 450 100 534  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_08 450 100 548  0.25 0.25 0.025 0.2  3000 0 0  0 0 0
ball shot_09 450 100 562  0.25 0.25 0.025 0.2  3000 0 0  0 0 0

box target_box_05 520 100 506  3.0 3.0 3.0  1.5 0.35
box target_box_06 520 100 520  3.0 3.0 3.0  1.5 0.35  0 15 0
box target_box_07 520 100 534  3.0 3.0 3.0  1.5 0.35  0 0 15
box target_box_08 520 100 548  3.0 3.0 3.0  1.5 0.35  0 25 10
box target_box_09 520 100 562  3.0 3.0 3.0  1.5 0.35  10 0 25
