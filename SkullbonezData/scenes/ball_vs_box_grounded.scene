# ball_vs_box_grounded.scene
# Tests angular velocity response when a ball hits a box off-center on terrain.
#
# The ball is launched horizontally but offset vertically from the box center,
# creating an off-axis collision with tangential contact velocity.
# Expected: both objects should receive angular velocity changes from friction at contact.
#
# Run: Debug build with --scene SkullbonezData/scenes/ball_vs_box_grounded.scene

physics on
text off
frames 300
fixed_step
exit_on_complete
physics_mode solver
world -9.81 0.0 998.0
flat_slope 30.0 0.0 0.0

camera overview 500 60 480  500 35 500  0 1 0


# Ball launched horizontally, positioned ABOVE box center for off-center hit
# ball <name> <x y z> <radius> <mass> <moment> <restitution> [fx fy fz fpx fpy fpz]
ball ball_striker 480 42 500  4.0 20.0 15.0 0.5  600 0 0  0 0 0

# Box resting on flat terrain (center at y=33, bottom face at y=30)
# box <name> <x y z> <halfX halfY halfZ> <mass> <restitution> [eulerX eulerY eulerZ]
box box_target 520 33 500  3.0 3.0 3.0  25.0 0.5
