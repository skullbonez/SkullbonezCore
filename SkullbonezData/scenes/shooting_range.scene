# shooting_range.scene
# Interactive projectile range: targets sit on a long fixed table with a large
# fixed backstop behind them so camera-fired bullets cannot disappear into the horizon.

seed 4242
physics on
text off
vsync off
frames unlimited
fixed_step
world -9.81 -1000.0 0.0
flat_slope 0.0 0.0 0.0
water_hidden on

camera range 330 105 500  620 70 500  0 1 0

# Long immovable rectangular table, aligned with the firing lane.
floating_box range_table 520 55 500  140.0 4.0 35.0  1000.0 0.2

# Large immovable block behind the targets. It catches missed shots and ricochets.
floating_box range_backstop 670 90 500  8.0 50.0 60.0  1000.0 0.2

# Mixed ball and box targets resting on the tabletop.
ball target_ball_left 455 63 486  4.0 12.0 5.0 0.35
ball target_ball_mid 515 63 508  4.0 12.0 5.0 0.35
ball target_ball_right 585 63 492  4.0 12.0 5.0 0.35

box target_box_left 485 63 515  4.0 4.0 4.0  20.0 0.35
box target_box_mid 545 63 480  4.0 4.0 4.0  20.0 0.35  0 15 0
box target_box_right 615 63 518  4.0 4.0 4.0  20.0 0.35  0 0 10
