# terrain_contact_probe_debug.scene
# Focused terrain probe scene for inspecting which terrain triangle a rolling
# sphere is over and where the sphere-center vertical terrain sample lands.

seed 6211
physics on
text off
vsync off
pipeline_sync off
fixed_step
frames 120
screenshot Profile/terrain_contact_probe_debug.bmp frame 120
exit_on_complete
water_hidden on
shadows on
cinematic_legacy_shadow_discs off
cinematic_shadow_map_size 2048
cinematic_shadow_pcf_radius 1
cinematic_shadow_strength 0.72
cinematic_shadow_softness 1.0
cinematic_shadow_depth_bias 0.00005
cinematic_shadow_slope_bias 0.00010
cinematic_shadow_max_distance 1400.0
physics_debug_terrain_contact on
world -30.0 -500.0 1.0
flat_slope 30.0 0.45 0.0

camera main 650 390 860  500 325 620  0 1 0

# Center Y is slope height at x=620 plus radius, matching the rolling demo
# setup so the magenta probe line exposes any terrain-height/contact offset.
ball terrain_probe_ball 620 333.000 620 24.0 120.0 24.0 0.35  0 0 0  0 0 0
