# ball_vs_box_flight.scene
# Tests angular velocity response when a ball hits a box off-center mid-air.
#
# Ball and box are at different heights so the collision normal is angled
# relative to the approach velocity — creating tangential contact velocity
# that produces angular impulse through friction.
#
# Run: Debug build with --scene SkullbonezData/scenes/ball_vs_box_flight.scene

physics on
text off
frames 300
fixed_step
exit_on_complete
physics_mode solver
world -9.81 0.0 998.0
flat_slope 30.0 0.0 0.0

camera overview 500 120 480  500 100 500  0 1 0


# Ball at y=100 launched horizontally (offset below box center)
# ball <name> <x y z> <radius> <mass> <moment> <restitution> [fx fy fz fpx fpy fpz]
ball ball_striker 480 100 500  4.0 20.0 15.0 0.5  600 0 0  0 0 0

# Box at y=107 (7 units higher than ball — off-center collision)
# box <name> <x y z> <halfX halfY halfZ> <mass> <restitution> [eulerX eulerY eulerZ]
box box_target 520 107 500  3.0 3.0 3.0  25.0 0.5
