# transparent_ball_water_alpha.scene
# Repro scene for Body alpha over water. Collision state is off so the balls
# should use the normal lit shader, with water not making them appear doubly faded.
physics off
text off
vsync off
exit_on_complete
frames 2
world -9.8 25.0 1.0
water_hidden off
water_flat on
water_reflection none
terrain_hidden off
collision_visualizer off
physics_debug_transparent on
physics_debug_alpha 0.35
ui visible off
screenshot Profile/transparent_ball_water_alpha.bmp frame 1

# Camera pulled back and elevated to show one alpha ball against sky, terrain, and water.
camera main 500 60 650  600 33 600  0 1 0

# Center ball straddles the water plane (water height 25, radius 12, center y 33).
ball water_alpha_center 600 33 600  12.0 50.0 10.0 0.8

# Side balls give visual references over sky/terrain without enabling collision-state colors.
ball water_alpha_left 575 45 595  9.0 30.0 8.0 0.8
ball water_alpha_right 625 50 605  9.0 30.0 8.0 0.8
