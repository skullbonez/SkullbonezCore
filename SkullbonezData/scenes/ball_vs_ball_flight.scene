# ball_vs_ball_flight.scene
# Two balls fired directly at each other in mid-air — no terrain contact.
# Both balls start well above the terrain, moving on a collision course along X.
# Expected: balls collide, exchange angular and linear velocity, diverge.
#
# Run: Debug build with --scene SkullbonezData/scenes/ball_vs_ball_flight.scene

physics on
text off
frames 300
fixed_step
exit_on_complete
world -9.81 0.0 998.0

camera overview 500 120 480  500 100 500  0 1 0


# Ball A: starts left, fires right
# ball <name> <x y z> <radius> <mass> <moment> <restitution> [fx fy fz fpx fpy fpz]
ball ball_a  470 120 500  4.0 20.0 15.0 0.7  300 0 0  0 0 0

# Ball B: starts right, fires left
ball ball_b  530 120 500  4.0 20.0 15.0 0.7  -300 0 0  0 0 0
