# physics_bench_solver_balls.scene
# Physics benchmark — impulse solver, 300 balls (no boxes).
#
# Isolates current-solver overhead for sphere-only workloads.
#
# Output: Profile/solver_balls_bench_perf_log.csv

seed 42
physics on
text off
vsync off
pipeline_sync off

camera cam1 321 110 557  581 40 633  0 1 0
camera cam2 730 100 380  709 92 482  0 1 0
camera cam3 900 110 900  313 31 282  0 1 0

solver_balls 300

perf_log Profile/solver_balls_bench_perf_log.csv
perf_log_flush off
