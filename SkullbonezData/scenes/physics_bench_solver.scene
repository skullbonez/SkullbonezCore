# physics_bench_solver.scene
# Physics benchmark — impulse solver, 200 balls + 100 boxes (300 objects total).
#
# Measures the sequential-impulse solver (SkullbonezImpulseSolver) overhead with a
# mixed object population.  physics_mode forces solver mode so this scene produces
# valid timings regardless of whether the exe was launched with --legacy.
#
# Paired with physics_bench_legacy.scene — run both via physics_bench.suite and
# compare using bench_report.py.
#
# Output: Profile/solver_bench_perf_log.csv

seed 42
physics_mode solver
physics on
text off
vsync off
pipeline_sync off
roll_align off

camera cam1 321 110 557  581 40 633  0 1 0
camera cam2 730 100 380  709 92 482  0 1 0
camera cam3 900 110 900  313 31 282  0 1 0

solver_balls 150
solver_boxes 150

perf_log Profile/solver_bench_perf_log.csv
perf_log_flush off
