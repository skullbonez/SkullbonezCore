# UI profiler timeline capture: bars positioned by their span inside the frame.
seed 4242
physics off
text off
vsync off
water_hidden on
terrain_hidden on
frames 60
perf_log Profile/ui_profiler_timeline_perf.csv
perf_log_flush on
ui tab profiler
ui rect 34 56 800 560
ui blur on
ui renderer_combo closed
ui profiler_expand all
ui timeline on
ui_test_pattern on
screenshot Profile/ui_profiler_timeline.bmp frame 50

camera main 500 60 650  600 33 600  0 1 0
