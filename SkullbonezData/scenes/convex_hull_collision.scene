# convex_hull_collision.scene
# Dynamic pileup fixture for authored convex hull collisions.

seed 42
physics on
text on
vsync off
frames 1800
fixed_step
time_scale 5.0
world -9.81 0.0 0.0
water_hidden on
collision_visualizer off
physics_debug_axes off
physics_debug_transparent off
physics_debug_alpha 0.35

camera overview 340 200 430  520 35 540  0 1 0

# 12 dynamic shapes total: 2 balls, 2 boxes, and 8 authored convex hulls.
ball hull_ball_a 500 135 500  7.0 24.0 12.0 0.35
ball hull_ball_b 540 150 525  6.0 20.0 10.0 0.35

box hull_box_a 515 120 490  4.0 3.0 3.0  28.0 0.25  0 20 0
box hull_box_b 480 145 535  3.0 5.0 3.0  32.0 0.30  15 0 30

convex_hull hull_hex_a 500 175 520  28.0 0.30 SkullbonezData/hulls/hex_prism.hull  0 15 0
convex_hull hull_diamond_a 530 185 505  24.0 0.35 SkullbonezData/hulls/diamond.hull  20 0 15
convex_hull hull_pyramid_a 490 195 515  22.0 0.30 SkullbonezData/hulls/pyramid.hull  0 35 10
convex_hull hull_wedge_a 520 165 545  26.0 0.25 SkullbonezData/hulls/wedge.hull  10 0 25
convex_hull hull_tapered_a 470 175 505  30.0 0.25 SkullbonezData/hulls/tapered_block.hull  0 -25 0
convex_hull hull_tri_prism_a 550 190 545  24.0 0.30 SkullbonezData/hulls/tri_prism.hull  25 15 0
convex_hull hull_hex_b 505 215 480  28.0 0.30 SkullbonezData/hulls/hex_prism.hull  35 0 45
convex_hull hull_diamond_b 535 225 535  24.0 0.35 SkullbonezData/hulls/diamond.hull  0 45 25
