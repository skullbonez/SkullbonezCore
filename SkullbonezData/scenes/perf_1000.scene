# Performance stress scene for SoA before/after comparison.
# 1000 generated balls, text overlay disabled, fixed-step simulation.
seed 42
physics on
text off
solver_balls 1000
vsync off
fixed_step
frames 1000
exit_on_complete
pipeline_sync off
camera cam1 321 110 557  581 40 633  0 1 0
camera cam2 730 100 380  709 92 482  0 1 0
camera cam3 900 110 900  313 31 282  0 1 0
perf_log Profile/perf_1000_log.csv
perf_log_flush off
perf_log_flush_interval 0
