# bullet_sweep_object.scene
# High-speed sphere fired into the corner of an immovable object.
# Regression command supplies --physics-collision-time-log.

seed 42
physics on
text off
vsync off
frames 3
fixed_step
exit_on_complete
world 0.0 -1000.0 0.0
flat_slope 0.0 0.0 0.0
water_hidden on
terrain_hidden on

camera overview 470 150 450  520 120 500  0 1 0

# Diagonal launch aims at the fixed cube corner. That makes the bounding-sphere
# swept candidate coincide with a real corner contact for the current CCD layer.
ball bullet_object 502.679 102.679 482.679  2.0 5.0 8.0 0.2  51961.525 51961.525 51961.525  0 0 0

floating_box fixed_object 520 120 500  4.0 4.0 4.0  1000.0 0.2
