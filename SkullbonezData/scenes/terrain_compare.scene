# terrain_compare.scene
# Terrain-only capture for DX11 vs DX12 texture filtering comparison.
# No balls, no HUD text, no water. Camera at high altitude looking diagonally
# across the terrain to stress mip levels at multiple distances.
physics off
text off
water_hidden on
screenshot TestOutput/terrain_cap.bmp frame 5
# High camera, steep diagonal view — near terrain (mip 0) at bottom,
# distant terrain (high mips) near top, no water visible.
camera main 200 500 1800  1400 0 200  0 1 0
