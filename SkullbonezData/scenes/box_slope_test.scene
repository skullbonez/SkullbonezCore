# box_slope_test.scene
# Verifies boxes can land flush on a sloped surface.
# On a slope, a box should tumble and eventually rest with a face flat against
# the slope plane (not necessarily axis-aligned to world).
#
# Success criteria:
#   - All boxes stop moving (velY near zero, omega near zero)
#   - Position is stable (not drifting or vibrating)
#   - Box center height matches terrain + halfExtent projected onto slope normal

physics on
text off
frames 1800
fixed_step
world -9.81 0.0 998.0

# Gentle 10-degree slope (slopeX = tan(10°) = 0.176)
flat_slope 40.0 0.176 0.0

# Camera
camera overview 500 200 500  500 130 500  0 1 0

# Box 1: flat drop onto slope (no initial rotation)
box box_slope_flat 500 145 500  2.0 2.0 2.0  10.0 0.5  0 0 0

# Box 2: tilted 30 degrees, dropped onto slope
box box_slope_tilt 520 145 500  2.0 2.0 2.0  10.0 0.5  30 0 0

# Box 3: non-uniform box on slope (wider in X)
box box_slope_wide 540 145 500  4.0 1.0 2.0  15.0 0.4  0 0 0

# Box 4: heavy box with low restitution (should settle fast)
box box_slope_heavy 500 145 520  2.0 2.0 2.0  50.0 0.1  0 0 0
