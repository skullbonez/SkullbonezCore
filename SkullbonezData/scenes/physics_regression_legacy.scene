# physics_regression_legacy.scene
# Physics regression baseline — legacy sphere-only solver.
#
# Runs 20 spheres for 300 fixed-step frames with a fixed seed.
# Output is fully deterministic: same binary CSV every run on the same build.
#
# Usage:
#   Debug\SKULLBONEZ_CORE.exe --scene SkullbonezData/scenes/physics_regression_legacy.scene
#
# The pipeline (Step 6.75) diffs Debug/physics_regression_legacy.csv against
# TestOutput/physics_regression_baselines/physics_regression_legacy.csv.
# If no baseline exists the current output is saved as the new baseline.

seed 42
physics_mode legacy
physics on
text off
frames 300
fixed_step
exit_on_complete
roll_align off
physics_log Debug/physics_regression_legacy.csv

camera cam1 321 110 557  581 40 633  0 1 0

legacy_balls 20
