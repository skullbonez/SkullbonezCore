# rolling_shadow_contact.scene
# Dynamic sphere-on-slope repro for real shadow contact in generated-style rendering.

seed 6210
physics on
text off
vsync off
pipeline_sync off
fixed_step
frames 180
screenshot Profile/rolling_shadow_contact.bmp frame 180
perf_log Profile/rolling_shadow_contact_perf_log.csv
perf_log_flush off
perf_log_flush_interval 0
exit_on_complete
water_hidden on
shadows on
cinematic_legacy_shadow_discs on
cinematic_shadow_map_size 2048
cinematic_shadow_pcf_radius 1
cinematic_shadow_strength 0.70
cinematic_shadow_softness 1.0
cinematic_shadow_depth_bias 0.0015
cinematic_shadow_slope_bias 0.0035
cinematic_shadow_max_distance 1400.0
world -30.0 -500.0 1.0
flat_slope 30.0 0.45 0.0

camera main 650 390 860  500 325 620  0 1 0

# Center Y is slope height at x=620 plus the radius, matching the generated demo
# terrain contact path. The ball rolls downhill while the contact-shadow layer
# keeps the grounding cue attached under the visible bottom of the sphere.
ball rolling_shadow_ball 620 333.000 620 24.0 120.0 24.0 0.35  0 0 0  0 0 0
