{
  "version": 1,
  "actions": [
    { "frame": 12, "showReplayScrubber": true },
    { "frame": 18, "clickReplayControl": "predict" },
    { "frame": 28, "clickObject": "path_striker", "button": "left" },
    { "frame": 45, "assert": { "replayPredictionEnabled": true } },
    { "frame": 45, "assert": { "replayPathTarget": "path_striker" } },
    { "frame": 80, "assert": { "predictionPathVisible": true } },
    { "frame": 85, "screenshot": "TestOutput/interaction/replay_prediction_after_click.bmp" },

    { "frame": 90, "setDevelopmentUiSurface": "imgui" },
    { "frame": 92, "assert": { "developmentUiSurface": "imgui" } },
    { "frame": 92, "assert": { "imguiVisible": true } },
    { "frame": 94, "resetImGuiLayout": true },
    { "frame": 96, "resizeWindow": [1024, 720] },
    { "frame": 98, "setImGuiDpiScale": 1.25 },
    { "frame": 100, "focusImGuiPanel": "Replay" },
    { "frame": 102, "setImGuiPanelVisible": { "panel": "Diag###SkoreDiagnostics", "visible": false } },
    { "frame": 104, "assert": { "imguiPanelMask": 3455 } },
    { "frame": 106, "setImGuiPanelVisible": { "panel": "Diag###SkoreDiagnostics", "visible": true } },
    { "frame": 108, "assert": { "imguiPanelMask": 3583 } },
    { "frame": 108, "assert": { "imguiLayoutResetCountMin": 1 } },
    { "frame": 108, "assert": { "imguiFocusCountMin": 1 } },
    { "frame": 108, "assert": { "imguiDpiScale": 1.25 } },
    { "frame": 110, "setDevelopmentUiSurface": "legacy" },
    { "frame": 112, "assert": { "developmentUiSurface": "legacy" } },
    { "frame": 112, "assert": { "imguiVisible": false } },
    { "frame": 114, "pressKey": "0", "control": true },
    { "frame": 114, "assert": { "developmentUiSurface": "imgui" } },
    { "frame": 114, "assert": { "legacyReplayPresentationActive": false } }
  ]
}
