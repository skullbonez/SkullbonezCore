# 03. Studio Lighting Showcase
style _concept_base
cinematic_style_modes 2 2 2 1
cinematic_exposure 0.90
cinematic_gamma 2.05
cinematic_sun_screen_x 0.70
cinematic_sun_screen_y 0.76
cinematic_sun_intensity 14.0
cinematic_style_grade 1.02 1.16 0.82
cinematic_clouds off
cinematic_fog off
cinematic_sun_color_r 1.00
cinematic_sun_color_g 0.96
cinematic_sun_color_b 0.88
cinematic_sky_horizon_r 0.42
cinematic_sky_horizon_g 0.45
cinematic_sky_horizon_b 0.48
cinematic_sky_zenith_r 0.025
cinematic_sky_zenith_g 0.027
cinematic_sky_zenith_b 0.030
cinematic_terrain_tint 0.88 0.89 0.90
cinematic_terrain_accent 0.86 0.90 1.00
cinematic_water_tint 0.68 0.70 0.72
cinematic_water_profile 0.78 0.78 0.08

# Object material look overrides.
object_material balls 1.0 1.0 1.0 beachball
object_material prefix:chrome 0.88 0.90 0.94 chrome
object_material prefix:white 0.92 0.92 0.88 matte
