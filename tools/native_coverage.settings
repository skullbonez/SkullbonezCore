<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <!-- Static native instrumentation is required for direct C++ process coverage. -->
    <EnableStaticNativeInstrumentation>True</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>

    <!--
      The parent doctest process owns coverage. Some tests launch the same
      executable to prove fatal and startup boundaries; collecting those child
      processes would turn their deliberate termination into collector failures.
      The parent still runs and checks every child probe.
    -->
    <CollectFromChildProcesses>False</CollectFromChildProcesses>
  </CodeCoverage>
</Configuration>
