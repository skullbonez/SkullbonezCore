{
  "schema_version": 1,
  "mode": "enforce",
  "owner_ratification": {
    "date": "2026-07-16",
    "decision": "Ratify the campaign-default tier map and line floors without amendment.",
    "governance_ruling": "Coverage floors are a quality gate, not a frozen-count debt ratchet; the AGENTS.md ban on ratchets for migration vocabulary does not apply."
  },
  "scope_rulings": [
    {
      "date": "2026-07-17",
      "owner": "unit-test-coverage-campaign U10",
      "scope": "SkullbonezSource/Physics/PhysicsApi.*",
      "decision": "Keep the standalone facade in validate_all_cpu_tests rather than the main doctest coverage floor.",
      "reason": "RunPhysicsStandaloneSmoke already owns the facade's lifecycle, query, contact, island, and activation matrix in the combined CPU gate; duplicating that large fixed-store probe in every doctest run would not improve the store floor."
    },
    {
      "date": "2026-07-17",
      "owner": "unit-test-coverage-campaign U10",
      "scope": "SkullbonezSource/Runtime/Replay/ReplayPredictionArchive.*",
      "decision": "Keep the prediction archive in the replay visual-fidelity system gate rather than the CPU artifact-codec floor.",
      "reason": "Its public values are constructed by ReplayPrediction and ReplayPresentation owners; U5's sole mega invocation exercised the production build/load/rebuild round-trip without adding a test-only runtime seam."
    },
    {
      "date": "2026-07-17",
      "owner": "unit-test-coverage-campaign U10",
      "scope": "SkullbonezSource/Runtime/Scene/SceneController.*",
      "decision": "Keep the engine-loop scene controller in Tier 4 and gate only SceneRequestQueue in the CPU scene-logic floor.",
      "reason": "U8 explicitly excludes engine-loop owners; scene request ordering remains the pure value seam and renderer/physics coordination stays system-gate owned."
    },
    {
      "date": "2026-07-17",
      "owner": "unit-test-coverage-campaign U10",
      "scope": "SkullbonezSource/Core/AmortizedTask.cpp",
      "decision": "Do not require the header-only template anchor to appear as an instrumented translation unit.",
      "reason": "The cpp contains only an include and no executable product line; AmortizedTask.h remains in the core primitive denominator through its behavioral tests."
    },
    {
      "date": "2026-07-17",
      "owner": "unit-test-coverage-campaign U10",
      "scope": "SkullbonezTests/TestRuntimeValueSeams.cpp replay overlay cases",
      "decision": "Treat replay overlay layout and value-packet cases as pure CPU owner contracts, not artifact or presentation-fidelity tests.",
      "reason": "They assert clamping, hit regions, and value projection without loading an artifact, launching the renderer, or changing visual-fidelity goldens; the sole U5 mega invocation remains the campaign's only replay system run."
    }
  ],
  "tiers": {
    "1": {
      "name": "Maths and core primitives",
      "ratified_floor_percent": 85.0
    },
    "2": {
      "name": "Physics, codecs, startup, and config",
      "ratified_floor_percent": 70.0
    },
    "3": {
      "name": "Runtime logic owners",
      "ratified_floor_percent": 50.0
    },
    "4": {
      "name": "System-gate-owned platform and presentation",
      "ratified_floor_percent": null
    }
  },
