---
Language: Cpp
BasedOnStyle: LLVM

# Indentation — spaces, 4 wide
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4

# Brace style — Allman (opening brace on its own line, always)
BreakBeforeBraces: Allman
InsertBraces: true

# Never allow braceless single-line if/for/while
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None

# Pointer/reference alignment — char* name (left, with type)
PointerAlignment: Left
ReferenceAlignment: Left

# Spaces inside parentheses — if ( x ), func( a, b )
SpacesInParens: Custom
SpacesInParensOptions:
  InConditionalStatements: true
  InEmptyParentheses: false
  Other: true

# Space before ( in control flow keywords
SpaceBeforeParens: ControlStatements

# Line endings — LF
LineEnding: LF

# Keep signatures and calls readable without forcing one-line declarations.
ColumnLimit: 120
BinPackParameters: false
BinPackArguments: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false
# Wrapped calls and initializers use one indentation step per nesting level.
# Their closing delimiter returns to the indentation of the line that opened it.
AlignAfterOpenBracket: BlockIndent
BracedInitializerIndentWidth: 4
PenaltyBreakBeforeFirstCallParameter: 0
# Keep the first aggregate value beside `{`; continuation values align beneath it.
Cpp11BracedListStyle: false
SpaceBeforeCpp11BracedList: true

# Don't reorder #includes (preserve existing grouping)
SortIncludes: Never
IncludeBlocks: Preserve

# Preserve two blank lines between functions (default MaxEmptyLinesToKeep is 1)
MaxEmptyLinesToKeep: 2

# Misc
SpaceAfterCStyleCast: false
SpacesInSquareBrackets: false
SpaceBeforeSquareBrackets: false
SpacesInAngles: Never
