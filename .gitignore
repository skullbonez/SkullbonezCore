# Visual Studio
.vs/
*.suo
*.user
*.vcxproj.user

# Build output
Debug/
Release/
Profile/

# Compiled object files
*.obj
*.pdb
*.ilk
*.lib
*.exp
*.exe
*.recipe

# MSBuild / tlog
*.tlog
*.log
*.lastbuildstate
*.FileListAbsolute.txt
*.CppClean.log

# IntelliSense / Browse DB
*.db
*.db-shm
*.db-wal
*.opendb
*.idb

# VS file content index
*.vsidx

# VS launch args (personal tool preference)
*.args.json

# Python
__pycache__/
*.pyc

# Superseded perf history dir (replaced by TestOutput/NNN_{commit}/ archives)
TestOutput/perf_history/

# TestOutput pipeline archives (numbered commit snapshots — large, local-only)
# TestOutput/baselines/ is still tracked (needed for pipeline regression comparisons)
TestOutput/[0-9]*/
TestOutput/baseline-*/

# Stale terrain-compare BMPs (large, not needed in source control)
TestOutput/terrain_*.bmp

# TestOutput generated artifacts are local-only: validation logs, screenshots,
# stress-watch folders, perf captures, and crash-test output. Keep committed
# baselines visible because validation depends on them.
TestOutput/*
!TestOutput/baselines/
!TestOutput/baselines/**

dx12_validation.txt

# Runtime-generated user snapshots and screenshots
# To keep a specific snapshot as a test case, move it to SkullbonezData/scenes/
# To keep a specific screenshot, move it to a deliberate tracked data folder
/Scenes/
/Screenshots/

# Root-level snapshot files saved before Scenes/ folder existed
/snapshot_*.scene

# Debug artifacts
build_out.txt
build_profile.txt
build_rel.txt
cdb_*.txt
crash_out.txt
