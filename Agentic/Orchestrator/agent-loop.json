{
  "schema_version": 1,
  "loop": "roadmap_agent_loop",
  "description": "Default JSON-only loop for implementing work sourced from Agentic/Plans.",
  "executable_state": {
    "policy": "Agentic/Orchestrator/policy.json",
    "queue": "Agentic/Orchestrator/queue.json",
    "item_machine": "Agentic/Orchestrator/machines/roadmap-item.json",
    "primary_command": "tools/orchestrator.bat run-loop",
    "finalize_command": "tools/orchestrator.bat finalize"
  },
  "default_for": [
    "Implementing any repository change from Agentic/Plans"
  ],
  "not_required_for": [
    "Reading a plan",
    "Drafting a new plan",
    "Updating plan status or handoff prose without implementing the plan"
  ],
  "inputs": {
    "worker_template": "Agentic/Orchestrator/templates/worker-prompt.md",
    "verifier_template": "Agentic/Orchestrator/templates/verifier-prompt.md",
    "report_template": "Agentic/Orchestrator/templates/report.md"
  },
  "guards": {
    "policy_enabled": {
      "source": "policy.enabled",
      "failure": "Stop unless the user explicitly asked for dry-run setup or policy editing."
    },
    "parallel_capacity_available": {
      "source": "policy.max_active_items",
      "rule": "A ready item may start only when active item count is below policy.max_active_items."
    },
    "no_conflicting_active_items": {
      "source": "queue.items owned_globs, impact_area, conflicts_with_areas",
      "rule": "A ready item may start beside active work only when dependencies are satisfied, owned_globs do not overlap, exclusive_globs are untouched, and impact-area limits allow it."
    },
    "isolated_worktrees_for_parallel_writers": {
      "source": "policy.parallelism.requires_isolated_worktrees",
      "rule": "Parallel writer agents should run in separate git worktrees; final integration remains orchestrator-owned."
    },
    "dependencies_satisfied": {
      "source": "queue.items.depends_on",
      "rule": "Dependencies must be in a state accepted by the item dependency_mode."
    },
    "verifier_available": {
      "source": "policy.verification",
      "rule": "A missing independent verifier blocks successful completion unless the user approves a fallback."
    },
    "report_only_commit_clean": {
      "source": "policy.reporting",
      "rule": "The final report commit may contain only report.md and referenced images."
    }
  },
  "steps": [
    {
      "id": "start",
      "action": "read_contracts",
      "reads": [
        "AGENTS.md",
        "README.md",
        "Agentic/README.md",
        "Agentic/SessionState.md",
        "Agentic/Orchestrator/policy.json",
        "Agentic/Orchestrator/queue.json",
        "Agentic/Orchestrator/agent-loop.json"
      ]
    },
    {
      "id": "select_item",
      "action": "select_highest_priority_ready_item_allowed_by_parallel_guards",
      "guards": [
        "policy_enabled",
        "parallel_capacity_available",
        "no_conflicting_active_items",
        "dependencies_satisfied"
      ],
      "output": "selected_item"
    },
    {
      "id": "prepare_run",
      "action": "create_run_directory",
      "path_template": "Agentic/Runs/<yyyy-mm-dd>/<item-id>/",
      "records": [
        "policy_snapshot",
        "queue_item_snapshot",
        "baseline_git_status",
        "start_time"
      ]
    },
    {
      "id": "branch_setup",
      "action": "create_or_switch_branch",
      "rules": [
        "Use policy.base_branch for independent items.",
        "Use stacked child branches when the queue item is part of a chain.",
        "Merge parent into child when updating a stacked branch; do not rebase.",
        "Use isolated git worktrees for concurrent writer agents."
      ]
    },
    {
      "id": "delegate_worker",
      "action": "render_and_send_worker_prompt",
      "template": "Agentic/Orchestrator/templates/worker-prompt.md",
      "output": "worker_result"
    },
    {
      "id": "review_worker_result",
      "action": "inspect_scope_and_evidence",
      "checks": [
        "changed_files_match_item_scope",
        "validation_ready_or_not_required",
        "artifacts_declared_or_not_required"
      ]
    },
    {
      "id": "verify",
      "action": "run_independent_verifier",
      "guards": [
        "verifier_available"
      ],
      "loop_on": "needs_fixes",
      "outputs": [
        "accepted",
        "needs_fixes",
        "blocked"
      ]
    },
    {
      "id": "validate",
      "action": "run_required_gate_once_ready",
      "rules": [
        "Documentation-only items record that no repository validation script is required.",
        "Code, shader, scene, physics, baseline, or tool items use AGENTS.md validation mapping."
      ]
    },
    {
      "id": "archive_plan",
      "action": "move_successful_source_plan",
      "rules": [
        "Use git mv from Agentic/Plans to Agentic/Plans/Done.",
        "Do not archive blocked or failed plans unless the user explicitly asks.",
        "Allow archive_deferred only with a reason in queue.json."
      ]
    },
    {
      "id": "report",
      "action": "create_report",
      "path_template": "Agentic/Reports/<yyyy-mm-dd>/<item-id>/report.md",
      "guards": [
        "report_only_commit_clean"
      ]
    },
    {
      "id": "terminal_update",
      "action": "set_terminal_state",
      "states": [
        "done",
        "pr_open",
        "merged",
        "blocked",
        "failed",
        "skipped"
      ]
    }
  ],
  "terminal_requirements": {
    "success": [
      "worker_result_saved",
      "verifier_accepted",
      "validation_passed_or_not_required",
      "report_created",
      "queue_terminal_state_set"
    ],
    "blocked_or_failed": [
      "reason_recorded",
      "report_created",
      "queue_terminal_state_set"
    ]
  }
}
