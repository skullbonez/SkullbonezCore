{
  "schema_version": 1,
  "description": "Legacy migration input. Agentic/Orchestrator/policy.yaml is authoritative.",
  "enabled": false,
  "base_branch": "main",
  "branch_prefix": "codex/",
  "plan_implementation": {
    "default_mode": "orchestration",
    "applies_to": [
      "Agentic/Plans/*.md"
    ],
    "bypass_requires": "explicit_user_request"
  },
  "branching": {
    "chained_items_use_stacked_branches": true,
    "first_item_base": "policy.base_branch",
    "child_item_base": "previous_item_branch",
    "update_child_with_parent_by_merge": true,
    "disallow_child_rebase": true
  },
  "max_active_items": 1,
  "allow_pr_creation": true,
  "allow_merge": false,
  "merge_requires_green_checks": true,
  "merge_requires_approval": false,
  "merge_method": "squash",
  "advance_after_failed_item": false,
  "stop_after_blocked_item": true,
  "stop_after_failed_item": true,
  "report_channels": [
    "markdown",
    "pr-comment"
  ],
  "email_reports": {
    "enabled": false,
    "to": []
  },
  "artifact_retention": {
    "run_root": "Agentic/Runs",
    "report_root": "Agentic/Reports",
    "commit_reports": true,
    "commit_report_images": true,
    "commit_run_state": false
  },
  "merge_safety": {
    "requires_agents_md_permission": true,
    "disallow_main_direct_push": true,
    "disallow_force_push": true,
    "disallow_rebase": true,
    "require_report_before_merge": true
  }
}
