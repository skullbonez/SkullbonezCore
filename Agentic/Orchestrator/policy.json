{
  "schema_version": 1,
  "description": "Executable orchestrator policy consumed by tools/orchestrator.py. YAML files are human-readable mirrors until YAML parser support is added.",
  "enabled": false,
  "base_branch": "main",
  "branch_prefix": "codex/",
  "max_active_items": 1,
  "plan_implementation": {
    "default_mode": "orchestration",
    "applies_to": [
      "Agentic/Plans/*.md"
    ],
    "bypass_requires": "explicit_user_request"
  },
  "branching": {
    "chained_items_use_stacked_branches": true,
    "first_item_base": "policy.base_branch",
    "child_item_base": "previous_item_branch",
    "update_child_with_parent_by_merge": true,
    "disallow_child_rebase": true
  },
  "pull_requests": {
    "allow_creation": true,
    "creation_not_required": false,
    "requires_enabled_policy": true,
    "requires_explicit_user_request": true
  },
  "merge": {
    "allow": false,
    "requires_agents_md_permission": true,
    "requires_green_checks": true,
    "requires_report_commit": true,
    "method": "squash"
  },
  "verification": {
    "requires_independent_verifier": true,
    "allow_same_agent_worker_fallback": true,
    "allow_same_agent_verifier_fallback": false,
    "missing_verifier_blocks_success": true
  },
  "queue": {
    "stop_after_blocked": true,
    "stop_after_failed": true,
    "advance_after_failed": false
  },
  "artifact_retention": {
    "run_root": "Agentic/Runs",
    "report_root": "Agentic/Reports",
    "commit_reports": true,
    "commit_report_images": true,
    "commit_run_state": false
  },
  "reporting": {
    "channels": [
      "markdown",
      "pr-comment"
    ],
    "final_report_commit_only": true,
    "report_images_must_be_referenced": true,
    "plain_language_first_section": true
  },
  "hard_blocks": {
    "direct_main_push": true,
    "force_push": true,
    "rebase": true,
    "history_rewrite": true,
    "broad_process_kill": true
  }
}
